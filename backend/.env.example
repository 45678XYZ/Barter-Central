# 複製成 .env 後填入實際的值（.env 已被 gitignore，不會進版控）
# 部署到 EC2 時，.env 由 IaC/app-stack.yaml 的 UserData 自動產生

# --- 資料庫 (AWS RDS MySQL) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- AWS Cognito ---
AWS_COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# 必須和 Cognito App Client 設定的 Callback URL 完全一致，例：http://localhost:5173/callback/
COGNITO_REDIRECT_URI=
# 只允許這個網域的信箱登入
ALLOWED_EMAIL_DOMAIN=g.ncu.edu.tw

# --- S3 (物品圖片上傳) ---
S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1
# 只有本機開發需要；EC2 上會改用 IAM Role，留空即可
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
